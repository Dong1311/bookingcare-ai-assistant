# Copy this file to .env and fill in your own OpenAI project key.
# Required for the chat model and text-embedding-3-small. Keep it server-side.
OPENAI_API_KEY=

# Assistant settings. Allowed models: gpt-5.4-mini, gpt-5.4, gpt-5.4-nano or supported snapshots.
CHAT_MODEL=gpt-5.4-mini
# Allowed reasoning levels: none, low, medium.
CHAT_REASONING_EFFORT=none

# Model used to grade the benchmark.
JUDGE_MODEL=gpt-5.4

# Local server port. Keep EVAL_BASE_URL empty to use http://127.0.0.1:<PORT>.
PORT=4173
EVAL_BASE_URL=
