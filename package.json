{
  "name": "bookingcare-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server/index.ts --dev",
    "start": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "ingest": "node --env-file-if-exists=.env --import tsx scripts/ingest.ts",
    "embed": "node --env-file-if-exists=.env --import tsx scripts/embed.ts",
    "eval": "node --env-file-if-exists=.env --import tsx eval/run.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@langchain/core": "1.3.5",
    "@langchain/openai": "1.8.2",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "robots-parser": "^3.0.1",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.0"
  }
}
